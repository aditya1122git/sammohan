# Dependencies
node_modules/
*/node_modules/

# Production build outputs
dist/
*/dist/
build/

# Environment variables (contains sensitive secrets & DB credentials)
.env
.env*.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Uploads and temporary files
backend/uploads/*
!backend/uploads/.gitkeep

# Large media files (>100MB exceeds GitHub push limit)
*.mp4
*.avi
*.mov

# OS and IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
